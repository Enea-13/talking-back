{
  "name": "talking-back",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Find the right Bible verse to answer a tempting thought, in seconds. Inspired by Evagrius of Pontus, Talking Back.",
  "scripts": {
    "dev": "vite",
    "build": "npm run data && tsc --noEmit && vite build",
    "build:web": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "data": "node scripts/build-data.mjs",
    "fetch-bibles": "node scripts/fetch-bibles.mjs",
    "sync": "npm run build && cap sync",
    "ios": "npm run sync && cap open ios",
    "android": "npm run sync && cap open android",
    "native-assets": "node scripts/native-assets.mjs"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "minisearch": "^7.2.0",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@preact/preset-vite": "^2.10.6",
    "@resvg/resvg-js": "^2.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  },
  "engines": {
    "node": "24.x"
  }
}
